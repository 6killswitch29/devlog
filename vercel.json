{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @devlog/web build",
  "outputDirectory": "apps/web/.next",
  "redirects": [
    { "source": "/blog", "destination": "/", "permanent": true }
  ]
}
