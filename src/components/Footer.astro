---
import { AUTHOR, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="container">
		<span>© {year} {AUTHOR}</span>
		<nav aria-label="바깥 링크">
			{SOCIAL.portfolio && <a href={SOCIAL.portfolio}>포트폴리오</a>}
			{SOCIAL.github && <a href={SOCIAL.github}>GitHub</a>}
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding-block: var(--space-4);
		font-size: 0.875rem;
		color: var(--fg-muted);
	}
	.container {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
	}
	nav {
		display: flex;
		gap: var(--space-3);
	}
	nav a {
		color: var(--fg-muted);
	}
	nav a:hover {
		color: var(--fg);
	}
</style>
