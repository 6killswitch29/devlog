---
// 글 목록. 연도별로 묶고, 각 행은 날짜 · 제목 · 태그.
import { postUrl, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;

const byYear = new Map<number, Post[]>();
for (const post of posts) {
	const year = post.data.pubDate.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

{
	posts.length === 0 ? (
		<p class="muted">아직 글이 없습니다.</p>
	) : (
		[...byYear].map(([year, group]) => (
			<section class="year">
				<h2>{year}</h2>
				<ul>
					{group.map((post) => (
						<li>
							<span class="date muted">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<div class="body">
								<a class="title" href={postUrl(post)}>
									{post.data.title}
									{post.data.draft && <span class="draft">초안</span>}
								</a>
								<div class="tags">
									{post.data.tags.map((tag) => (
										<Tag tag={tag} />
									))}
								</div>
							</div>
						</li>
					))}
				</ul>
			</section>
		))
	)
}

<style>
	.year + .year {
		margin-top: var(--space-5);
	}
	h2 {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--fg-muted);
		margin-bottom: var(--space-3);
		padding-bottom: var(--space-1);
		border-bottom: 1px solid var(--border);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: var(--space-3);
		padding: var(--space-3) 0;
	}
	li + li {
		border-top: 1px solid var(--border);
	}
	.date {
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		padding-top: 0.15em;
	}
	.title {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: 600;
		color: var(--fg);
	}
	.title:hover {
		color: var(--accent);
	}
	.draft {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--fg-muted);
		border: 1px dashed var(--fg-muted);
		border-radius: 4px;
		padding: 0 0.4em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin-top: var(--space-1);
	}
	@media (max-width: 560px) {
		li {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
