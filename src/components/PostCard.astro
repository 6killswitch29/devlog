---
// 홈 카드 그리드의 글 카드. featured면 최신 글용 큰 카드.
import { postUrl, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: Post;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, tags, series, draft } = post.data;
---

<a class:list={['card', { featured }]} href={postUrl(post)}>
	<p class="meta">
		{featured && <span class="new">NEW</span>}
		<FormattedDate date={pubDate} />
		{series && <span class="series">· {series}</span>}
		{draft && <span class="draft">초안</span>}
	</p>
	<h3 class="title">{title}</h3>
	<p class="description">{description}</p>
	<ul class="tags" aria-label="태그">
		{tags.map((tag) => <li>#{tag}</li>)}
	</ul>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--bg);
		color: var(--fg);
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}
	.card:hover {
		text-decoration: none;
		border-color: var(--accent);
	}
	.card:hover .title {
		color: var(--accent);
	}
	.featured {
		padding: var(--space-5);
		background: var(--bg-subtle);
		gap: var(--space-3);
	}

	.meta {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: 0.8125rem;
		color: var(--fg-muted);
	}
	.new {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--accent);
	}
	.series {
		color: var(--accent);
	}
	.draft {
		font-size: 0.75rem;
		border: 1px dashed var(--fg-muted);
		border-radius: 4px;
		padding: 0 0.4em;
	}

	.title {
		margin: 0;
		font-size: 1.1875rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		transition: color 0.15s;
	}
	.featured .title {
		font-size: 1.625rem;
		font-weight: 800;
		line-height: 1.4;
		letter-spacing: -0.02em;
	}

	.description {
		margin: 0;
		font-size: 0.9063rem;
		line-height: 1.65;
		color: var(--fg-muted);
	}
	.featured .description {
		font-size: 0.9688rem;
		line-height: 1.7;
		color: var(--fg);
		opacity: 0.85;
		max-width: 40rem;
	}

	.tags {
		list-style: none;
		margin: auto 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		padding-top: var(--space-1);
	}
	.tags li {
		font-size: 0.78rem;
		line-height: 1.6;
		padding: 0.05em 0.65em;
		border-radius: 999px;
		background: var(--bg-subtle);
		color: var(--fg-muted);
	}
	.featured .tags li {
		background: var(--bg);
		border: 1px solid var(--border);
	}
</style>
