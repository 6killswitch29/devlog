---
// 이전 글 = 더 오래된 글, 다음 글 = 더 새로운 글.
import { postUrl, type Post } from '../lib/posts';

interface Props {
	older?: Post;
	newer?: Post;
}

const { older, newer } = Astro.props;
---

{
	(older || newer) && (
		<nav class="post-nav" aria-label="이전/다음 글">
			{older ? (
				<a class="older" href={postUrl(older)}>
					<span class="label muted">← 이전 글</span>
					<span class="title">{older.data.title}</span>
				</a>
			) : (
				<span />
			)}
			{newer && (
				<a class="newer" href={postUrl(newer)}>
					<span class="label muted">다음 글 →</span>
					<span class="title">{newer.data.title}</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-3);
		margin-top: var(--space-6);
		padding-top: var(--space-4);
		border-top: 1px solid var(--border);
	}
	a {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--fg);
	}
	a:hover {
		border-color: var(--accent);
		text-decoration: none;
	}
	.newer {
		text-align: right;
	}
	.label {
		font-size: 0.8125rem;
	}
	.title {
		font-weight: 600;
		font-size: 0.9375rem;
	}
	@media (max-width: 560px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
		.newer {
			text-align: left;
		}
	}
</style>
