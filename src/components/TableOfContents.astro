---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

// h2, h3만 목차에 올린다. 각주 섹션 제목(footnote-label)은 제외.
const items = Astro.props.headings.filter(
	(h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label',
);
---

{
	items.length > 0 && (
		<nav class="toc" aria-label="목차">
			<ul>
				{items.map((h) => (
					<li class:list={[`depth-${h.depth}`]}>
						<a href={`#${h.slug}`}>{h.text}</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.875rem;
		line-height: 1.5;
	}
	li {
		margin: 0.35em 0;
	}
	.depth-3 {
		padding-left: 1em;
	}
	a {
		color: var(--fg-muted);
	}
	a:hover {
		color: var(--fg);
		text-decoration: none;
	}
</style>
