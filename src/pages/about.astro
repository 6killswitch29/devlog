---
import { AUTHOR, SOCIAL } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="About" description={`${AUTHOR}의 개발일지 소개`}>
	<div class="container prose">
		<h1>About</h1>
		<!-- TODO: 실제 소개로 교체. 상세 이력은 포트폴리오(showreel)가 담당한다. -->
		<p>
			{AUTHOR}의 개발일지입니다. 배운 것, 만든 것, 삽질한 것을 기록합니다.
		</p>
		{
			SOCIAL.portfolio && (
				<p>
					이력과 프로젝트는 <a href={SOCIAL.portfolio}>포트폴리오</a>에 정리되어 있습니다.
				</p>
			)
		}
	</div>
</Base>

<style>
	h1 {
		margin-bottom: var(--space-4);
	}
</style>
