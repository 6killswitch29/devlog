---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, getSeries, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts(); // 최신순
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const seriesPosts = post.data.series ? await getSeries(post.data.series) : [];
---

<BlogPost post={post} headings={headings} older={older} newer={newer} seriesPosts={seriesPosts}>
	<Content />
</BlogPost>
